# Optional remote database configuration. Copy to .env.develop.
# ./run.sh develop runs Docker locally against the configured database.
SPRING_DATASOURCE_URL=jdbc:postgresql://<database-host>:5432/<database-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Generate a distinct secret for the shared development backend.
SECURITY_JWT_SECRET=
SECURITY_JWT_EXPIRATION=3600000
PORT=8081
# Development only: this backend will update the shared database schema.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
