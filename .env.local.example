# Copy to .env.local. Used by Compose (Windows/Linux) or run.sh local (Linux).
# Compose creates its own database using the username/password below.
# This host URL is only for run.sh; Compose overrides it with its db service URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/adoptr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Generate a fresh value with: openssl rand -hex 32
# PowerShell alternative (64 hexadecimal characters):
# [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SECURITY_JWT_SECRET=
SECURITY_JWT_EXPIRATION=3600000
PORT=8081
SPRING_JPA_HIBERNATE_DDL_AUTO=update
