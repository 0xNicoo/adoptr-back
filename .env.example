# Copy to .env and fill in your own values. Never commit .env.
# Docker's localhost is the container itself: use a reachable database hostname.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/adoptr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Generate a fresh value with: openssl rand -hex 32
SECURITY_JWT_SECRET=
SECURITY_JWT_EXPIRATION=3600000
PORT=8081
# update is only for this shared development environment, not production.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
